# Copy to .env.docker and fill in the two required secrets:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# .env.docker is gitignored. Never commit real values.

# === Required ===============================================================
# Generate both with:  openssl rand -base64 48
# JWT_SECRET must be at least 32 characters or sign-in will reject it.
JWT_SECRET=
API_ENCRYPTION_KEY=

# === Database ===============================================================
POSTGRES_USER=profolio
POSTGRES_PASSWORD=profolio
POSTGRES_DB=profolio
# Host port only. Defaults to 5433 to avoid clashing with a local Postgres.
POSTGRES_PORT=5433

# === Redis ==================================================================
# Leave empty for no password (fine when Redis is not published beyond the
# compose network). Set a value for any deployment reachable from elsewhere.
REDIS_PASSWORD=
REDIS_PORT_HOST=6380

# === Application ============================================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true

# === Build-time frontend flags ==============================================
# These are inlined into the client bundle, so changing one needs a rebuild.
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_SHOW_LANDING_PAGE=true
NEXT_PUBLIC_ALLOW_REGISTRATION=true
