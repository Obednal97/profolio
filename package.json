{
  "name": "profolio",
  "version": "1.18.0",
  "description": "Professional Self-Hosted Portfolio Management System - Complete data control and privacy for your financial portfolio tracking",
  "main": "install.sh",
  "scripts": {
    "start": "concurrently \"pnpm start:backend\" \"pnpm start:frontend\"",
    "start:dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "start:backend": "cd backend && pnpm start",
    "start:frontend": "cd frontend && pnpm start",
    "dev": "pnpm start:dev",
    "dev:clean": "./scripts/dev-with-cleanup.sh",
    "cleanup": "./scripts/cleanup-ports.sh",
    "dev:backend": "cd backend && pnpm run start:dev",
    "dev:frontend": "cd frontend && pnpm run dev",
    "build": "pnpm build:backend && pnpm build:frontend",
    "build:backend": "cd backend && pnpm run build",
    "build:frontend": "cd frontend && pnpm run build",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "cd backend && pnpm test",
    "test:frontend": "cd frontend && pnpm test",
    "update": "./install.sh",
    "deploy": "./deploy.sh",
    "setup": "./setup.sh",
    "prepare": "husky",
    "check:all": "pnpm run check:backend && pnpm run check:frontend",
    "check:backend": "cd backend && pnpm run lint && pnpm run type-check",
    "check:frontend": "cd frontend && pnpm run lint && pnpm run type-check",
    "fix:all": "pnpm run fix:backend && pnpm run fix:frontend",
    "fix:backend": "cd backend && pnpm run lint:fix",
    "fix:frontend": "cd frontend && pnpm run lint:fix",
    "type-check": "node scripts/check-any-types.js",
    "type-check:strict": "node scripts/check-any-types.js --strict"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Obednal97/profolio.git"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0"
  },
  "pnpm": {
    "overrides": {
      "jws@3": "^3.2.3",
      "jws@4": "^4.0.1",
      "jsonwebtoken@9": "^9.0.3",
      "multer": "^2.2.0",
      "validator@13": "^13.15.35",
      "fast-xml-parser@4": "^4.5.7",
      "protobufjs@7": "^7.6.5",
      "websocket-driver": "^0.7.5",
      "preact@10": "^10.29.8",
      "minimatch@3": "^3.1.5",
      "node-forge@1": "^1.4.0",
      "postcss@8": "^8.5.26",
      "nanoid@3": "^3.3.18"
    }
  },
  "keywords": [
    "portfolio",
    "finance",
    "self-hosted",
    "investment-tracking",
    "proxmox",
    "homelab",
    "privacy",
    "typescript",
    "nextjs",
    "nestjs"
  ],
  "author": "Ollie Bednal <contact@profolio.app>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Obednal97/profolio/issues"
  },
  "homepage": "https://github.com/Obednal97/profolio#readme",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.14.4",
  "files": [
    "install.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "policies/"
  ],
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "cd frontend && pnpm run lint:fix",
      "cd frontend && pnpm run type-check:dev"
    ],
    "backend/**/*.ts": [
      "cd backend && pnpm run lint:fix",
      "cd backend && pnpm run type-check"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
