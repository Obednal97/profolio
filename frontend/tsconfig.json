{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // `baseUrl` is deprecated in TypeScript 6 and removed in 7, but it cannot
    // be dropped yet: Next's webpack resolver reads baseUrl+paths from this
    // file to build its module aliases, and without it every `@/...` import
    // fails to resolve at build time (verified - the build breaks outright).
    // ignoreDeprecations silences the TS6 warning until Next's resolver stops
    // depending on baseUrl.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "tailwind.config.ts", "tailwind.ts"]
}
