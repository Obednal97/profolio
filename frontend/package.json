{
  "name": "frontend",
  "version": "1.18.0",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "start": "next start",
    "start:dev": "next dev",
    "dev": "next dev",
    "dev:https": "node scripts/dev-https.js",
    "dev:https:simple": "node scripts/dev-https-simple.js",
    "dev:pwa": "pnpm run dev:https",
    "dev:mobile": "pnpm run dev:https",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start:https": "HTTPS=true next start -p 3000",
    "type-check": "tsc --noEmit",
    "type-check:dev": "tsc --noEmit -p tsconfig.dev.json",
    "lint": "eslint . --max-warnings 80",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "HEADED=true playwright test --ui",
    "test:e2e:debug": "HEADED=true playwright test --debug",
    "test:headless": "playwright test",
    "test:headed": "HEADED=true playwright test",
    "test:ci": "playwright test --config=playwright.ci.config.ts",
    "test:performance": "mkdir -p reports && lighthouse http://localhost:3000 --chrome-flags='--headless --no-sandbox' --quiet --no-enable-error-reporting --output=json --output-path=./reports/lighthouse-report.json",
    "test:performance:headed": "mkdir -p reports && lighthouse http://localhost:3000 --output=json --output-path=./reports/lighthouse-report.json",
    "test:security": "pnpm audit --audit-level=moderate && pnpm run test:e2e:security",
    "test:e2e:security": "playwright test --grep='@security'",
    "test:all": "pnpm run test:e2e && pnpm run test:performance",
    "test:quick": "playwright test --config=playwright.ci.config.ts --grep-invert='@slow|visual'",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "clean:all": "pnpm run clean && rm -rf node_modules && pnpm install",
    "pwa:audit": "npx lighthouse https://localhost:3000 --only-categories=pwa --chrome-flags='--ignore-certificate-errors'",
    "pwa:test": "echo 'Open https://localhost:3000 in Chrome > DevTools > Application > Service Workers'",
    "pwa:clear": "echo 'Clear PWA cache: DevTools > Application > Storage > Clear storage'",
    "pwa:setup": "echo 'Run: mkcert -install && mkdir -p .certificates && cd .certificates && mkcert localhost 127.0.0.1 ::1 $(ipconfig getifaddr en0)'"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "16.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@stripe/stripe-js": "^9.13.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/decimal.js": "^0.0.32",
    "@types/jsonwebtoken": "^9.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "dompurify": "^3.4.13",
    "file-saver": "^2.0.5",
    "firebase": "^12.17.1",
    "framer-motion": "^13.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "^5.2.133",
    "react": "19.2.8",
    "react-confetti": "^6.4.0",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint/eslintrc": "^3.3.6",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "beasties": "^0.3.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "http-proxy": "^1.18.1",
    "lighthouse": "^13.4.1",
    "pixelmatch": "^7.2.0",
    "postcss-import": "^16.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
