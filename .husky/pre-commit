echo "🔍 Running pre-commit checks..."

# Auto-fix staged files
pnpm lint-staged

# Non-blocking quality signal. Warnings are allowed so a work-in-progress
# commit is never blocked; CI is the strict gate.
echo "📝 Running type and lint checks (warnings allowed)..."
pnpm run lint --max-warnings 100 2>/dev/null || echo "  ⚠️  Lint warnings (allowed)"
pnpm run type-check:dev 2>/dev/null || echo "  ⚠️  Type warnings (allowed)"

echo "🔍 Checking for 'any' types..."
node scripts/check-any-types.js --pre-commit || true

echo "✅ Pre-commit checks complete. Warnings don't block commits."
